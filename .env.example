# Copy to .env and adjust for local docker-compose use.
POS_SECRET_KEY=change-me-to-a-long-random-string

# -- Razorpay (UPI QR payments) --------------------------------------
# Test-mode defaults are safe to leave as-is for local dev. Get real
# keys from https://dashboard.razorpay.com/app/keys and a webhook
# secret from https://dashboard.razorpay.com/app/webhooks (point the
# webhook at POST /api/v1/payments/razorpay/webhook).
POS_RAZORPAY_KEY_ID=rzp_test_0000000000000
POS_RAZORPAY_KEY_SECRET=test_secret_change_me
POS_RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_change_me

# -- MSG91 (SMS) -------------------------------------------------------
# Leave blank to keep SMS notifications on the safe logging adapter.
# Get a real auth key + Flow API template ID from
# https://control.msg91.com/app/dashboard.
POS_MSG91_AUTH_KEY=
POS_MSG91_SENDER_ID=POSAPP
POS_MSG91_FLOW_ID=

# -- Epson ESC/POS thermal printer (network) ---------------------------
# ESC/POS printers listen on raw TCP port 9100 by convention. Set to
# your printer's real LAN IP and POS_PRINTER_ENABLED=true to print for
# real; otherwise printing is a safe no-op.
POS_PRINTER_HOST=192.168.1.100
POS_PRINTER_PORT=9100
POS_PRINTER_ENABLED=false

# -- GST Suvidha Provider (e-filing) ------------------------------------
# "mock" fully exercises the generate/submit/status workflow with a fake
# GSP. Set to "http" once you have a real GSP contract (ClearTax, Cygnet,
# MasterGST, etc.) and fill in the base URL + API key.
POS_GSP_PROVIDER=mock
POS_GSP_BASE_URL=https://sandbox.example-gsp.invalid
POS_GSP_API_KEY=mock-gsp-api-key
